library(seasonal)
# Read CSV (auto-detects Date column)
data <- read.csv("data_raw/oecdcrude_unadjusted.csv")
# Read CSV (auto-detects Date column)
data <- read.csv("oecdcrude_unadjusted.csv")
# Convert to time series (monthly)
y <- ts(data$oecdcrude, frequency = 12, start = c(1988, 1))
# Run X-13ARIMA-SEATS
m <- seas(y)
# Extract seasonally adjusted series
data$oecdcrude_sa <- final(m)
plot(final(m))
# Convert to time series (monthly)
y <- ts(data$oecdcrude, frequency = 12, start = c(1980, 1))
# Run X-13ARIMA-SEATS
m <- seas(y)
# Extract seasonally adjusted series
data$oecdcrude_sa <- final(m)
plot(final(m))
write.csv(data, "data_raw/oecdcrude_adjusted.csv", row.names = FALSE)
write.csv(data, "oecdcrude_adjusted.csv", row.names = FALSE)
# Convert to time series with frequency = 3
y <- ts(data$oecdcrude, frequency = 3, start = c(1980, 1))
# STL decomposition (Seasonal-Trend decomposition using Loess)
m <- stl(y, s.window = "periodic")
# Extract seasonally adjusted series (trend + remainder)
data$oecdcrude_sa <- seasadj(m)
library(forecast)
