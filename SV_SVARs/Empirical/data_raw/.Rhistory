library(MASS)
library(MCMCpack)
# Log posterior density function
lposterior_v = function(v, lambda) {
n = length(lambda)
sum1 = sum(1 / lambda)
sum2 = sum(log(lambda))
logpost = rep(NA, length(v))
for (k in 1:length(v)) {
norm = n * (-lgamma(v[k] / 2) + (v[k] / 2) * log(v[k] / 2))
logpost[k] = -((v[k] / 2) + 1) * sum2 - (v[k] / 2) * sum1 + norm
}
logpost
}
n = 300 # change the number of observations
K = 3 # number of regressors
set.seed(123) # For consistency
# generate data
X = matrix(1, n, K)
for (k in 2:K) {
X[, k] = rnorm(n)
}
y = 3 + 2 * X[, 2] - 2 * X[, 3] + rt(n, 6)
rnorm(n)
y = (as.matrix(y))
ols = lm(y ~ X - 1)
summary(ols)
# number of burn in (R) and number of draws to keep (N)
N = 20000
R = 1000
# Prior distribution parameters
K = ncol(X)
# Mean(b0) and variance(B0) for beta
b0 = rep(0, K)
B0 = 2.500 * diag(K) # use a "small variance" (e.g. 0.0001) -> informative prior
# Shape (alpha0) and scale(delta0) for sigma squared
alpha0 = 0.001
delta0 = 0.001
# degrees of freedom
v = 3
vest = 1 # 1: estimate v
# save stuff
beta = matrix(NA, R + N, K)
sigma2 = rep(NA, R + N)
lambdasave = matrix(NA, R + N, dim(y)[1])
vsave = matrix(NA, R + N, 1)
# Initialize
start = summary(ols)$coef[, 1] # try different starting values
beta[1, ] = cbind(t(start))
lambda = matrix(1, dim(X)[1], 1)
W = diag(dim(X)[1])
########## Gibbs Sampler######################################
for (i in 2:(R + N)) {
if (i %% 1000 == 0) {
# Keep track of iterations
cat(paste0("iteration: ", i, "\n"))
}
## draw sigma
# Parameters for conditional distribution
alpha1 = alpha0 + n / 2
delta1 = delta0 + t(y - X %*% beta[i - 1, ]) %*% W %*% (y - X %*% beta[i - 1, ]) / 2
# draw
sigma2[i] = rinvgamma(1, alpha1, delta1)
## draw beta
# Parameters for conditional distribution
B1 = solve((1 / sigma2[i]) * t(X) %*% W %*% X + solve(B0))
b1 = B1 %*% ((1 / sigma2[i]) * t(X) %*% W %*% y + solve(B0) %*% b0)
# draw
beta[i, ] = t(mvrnorm(1, b1, B1)) # replace this with chol
## draw lambda
lambda = rinvgamma(dim(X)[1], (v + 1) / 2, 0.5 * (v * matrix(1, dim(X)[1], 1) + ((y - X %*% beta[i, ])^2) / sigma2[i]))
# Note: often the gamma distribution is parameterised with scale (scale=1/rate and rate is beta) in matlab it is also parameterised with scale
diag(W) = 1 / lambda
lambdasave[i, ] = lambda
## draw v, with Griddy-Gibbs sampler
if (vest == 1) {
# construct the grid
grid = seq(2 + runif(1) * 0.001, 50 - runif(1) * 0.001, by = 0.001)
# compute CDF
lpb = lposterior_v(grid, lambda)
pv = exp(lpb - max(lpb)) # unnormalized density (for numerical stability)
PV = pv / sum(pv)
cdfv = cumsum(PV)
# find v (smallest index such that the CDF >= U)
v = grid[min(which((runif(1) < cdfv) == TRUE))]
}
vsave[i, 1] = v
}
# draws plots
par(mfrow = c(2, 2))
plot(beta[, 1], type = "l")
plot(beta[, 2], type = "l")
plot(beta[, 3], type = "l")
plot(vsave, type = "l")
# delete burn-in period
beta = beta[(R + 1):(R + N), ]
sigma2 = sigma2[(R + 1):(R + N)]
vsave = vsave[(R + 1):(N + R), 1]
# autocorrelations
acf(beta[, 1])
acf(beta[, 2])
acf(beta[, 3])
acf(vsave, lag.max = 100)
# Marginals
mean(vsave)
apply(beta, 2, mean)
mean(sigma2)
apply(beta, 2, sd)
